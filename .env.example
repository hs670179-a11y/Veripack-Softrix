# VeriPack environment. This file is git-ignored — never commit a real key.
#
# 1. Get a key at https://aistudio.google.com/apikey
# 2. Paste it after the '=' below (no quotes, no spaces).
# 3. Restart `npm run dev` after changing this file.
#    Vercel does NOT read this file — set the same variables in
#    Vercel project Settings → Environment Variables.
VITE_GEMINI_API_KEY=

# Gemini model used for rule checking and the visual condition check.
# Verified current at build time (2026-09-14) against
# https://ai.google.dev/gemini-api/docs/models — do not assume this stays valid.
VITE_GEMINI_MODEL=gemini-3.8-flash
